@model CallCenterPlus.Models.RequestSummaryViewModel
@{
    ViewData["Title"] = "Resumen de la solicitud";
}

<div class="cc-wrap">
    <partial name="_Stepper" model="3" />

    <div class="cc-card">
        <h1 class="cc-page-title">Revisa tu solicitud</h1>
        <p class="cc-page-subtitle">Verifica que todo esté correcto antes de enviarla al equipo de soporte.</p>

        <form asp-controller="Request" asp-action="SubmitRequest" method="post" id="summaryForm">
            @Html.AntiForgeryToken()
        <div class="cc-summary-list">
            <div class="cc-summary-row">
                <div class="cc-summary-icon"><i class="bi bi-person"></i></div>
                <div style="flex:1;">
                    <div class="cc-summary-label">Solicitante</div>
                    <div class="cc-summary-value">@Model.Requester.EmployeeName</div>

                    <div class="cc-detail-grid" style="margin:14px 0 0;">
                        <div class="cc-detail-stat">
                            <div class="cc-summary-label">Cédula</div>
                            <div class="cc-summary-value" style="font-size:.85rem;">@Model.Requester.EmployeeIdNumber</div>
                        </div>
                        <div class="cc-detail-stat">
                            <div class="cc-summary-label">Cargo</div>
                            <div class="cc-summary-value" style="font-size:.85rem;">@Model.Requester.JobTitle</div>
                        </div>
                        <div class="cc-detail-stat">
                            <div class="cc-summary-label">Gerencia</div>
                            <div class="cc-summary-value" style="font-size:.85rem;">@Model.Requester.ManagementName</div>
                        </div>
                        <div class="cc-detail-stat">
                            <div class="cc-summary-label">División</div>
                            <div class="cc-summary-value" style="font-size:.85rem;">@Model.Requester.ManagementDivisionName</div>
                        </div>
                        <div class="cc-detail-stat">
                            <div class="cc-summary-label">Estado</div>
                            <div class="cc-summary-value" style="font-size:.85rem;">@Model.Requester.StateName</div>
                        </div>
                        <div class="cc-detail-stat">
                            <div class="cc-summary-label">ID interno</div>
                            <div class="cc-summary-value" style="font-size:.85rem;">@Model.Requester.EmployeeId</div>
                        </div>
                    </div>

                    <div class="cc-field" style="margin-top:16px;">
                        <label class="cc-label" for="ExtensionOrCellPhone">Número de extensión / celular <span class="text-muted fw-normal">(opcional)</span></label>
                        <input type="text" inputmode="numeric" class="cc-input" id="ExtensionOrCellPhone" name="ExtensionOrCellPhone" maxlength="11" placeholder="Ej: 8091234567" autocomplete="off" />
                    </div>
                </div>
            </div>
            <div class="cc-summary-row">
                <div class="cc-summary-icon"><i class="bi @Model.RequestTypeIcon"></i></div>
                <div>
                    <div class="cc-summary-label">Tipo de solicitud</div>
                    <div class="cc-summary-value">@Model.RequestTypeName</div>
                </div>
            </div>
            <div class="cc-summary-row">
                <div class="cc-summary-icon"><i class="bi bi-chat-square-text"></i></div>
                <div>
                    <div class="cc-summary-label">Detalles</div>
                    <div class="cc-summary-value cc-fw-normal">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Sin detalles adicionales." : Model.Description)
                    </div>
                </div>
            </div>
            <div class="cc-summary-row">
                <div class="cc-summary-icon"><i class="bi bi-calendar3"></i></div>
                <div>
                    <div class="cc-summary-label">Fecha</div>
                    <div class="cc-summary-value">@Model.Date.ToString("dd 'de' MMMM 'de' yyyy, hh:mm tt", new System.Globalization.CultureInfo("es-ES"))</div>
                </div>
            </div>
        </div>

        @if (ViewBag.SubmitError is not null)
        {
            <div class="cc-alert-note" style="background:var(--cc-warning-light); color:#a5680a;">
                <i class="bi bi-exclamation-triangle"></i>
                <span>@ViewBag.SubmitError</span>
            </div>
        }
        else
        {
            <div class="cc-alert-note">
                <i class="bi bi-info-circle"></i>
                <span>Un técnico de la Gerencia de Tecnología revisará tu solicitud y le dará seguimiento a la brevedad.</span>
            </div>
        }

            <div class="cc-actions">
                <a class="cc-btn cc-btn-outline" asp-controller="Request" asp-action="NewRequest">
                    <i class="bi bi-arrow-left"></i> Atrás
                </a>
                <button type="submit" class="cc-btn cc-btn-primary">
                    Enviar solicitud <i class="bi bi-send"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var extInput = document.getElementById('ExtensionOrCellPhone');
            if (extInput) {
                extInput.addEventListener('input', function () {
                    var digitsOnly = this.value.replace(/[^0-9]/g, '').slice(0, 11);
                    if (digitsOnly !== this.value) {
                        this.value = digitsOnly;
                    }
                });
                extInput.addEventListener('keydown', function (e) {
                    var allowedKeys = ['Backspace', 'Delete', 'Tab', 'ArrowLeft', 'ArrowRight', 'Home', 'End'];
                    if (allowedKeys.indexOf(e.key) !== -1) return;
                    if (!/^[0-9]$/.test(e.key) || this.value.length >= 11) {
                        e.preventDefault();
                    }
                });
            }
        })();
    </script>
}

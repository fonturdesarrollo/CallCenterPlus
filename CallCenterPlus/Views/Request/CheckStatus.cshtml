@model List<CallCenterPlus.Models.FakeTicket>
@{
    ViewData["Title"] = "Consultar estatus";

    string BadgeClass(string status) => status switch
    {
        "Abierto" => "cc-badge-abierto",
        "En Proceso" => "cc-badge-enproceso",
        "Resuelto" => "cc-badge-resuelto",
        "Cerrado" => "cc-badge-cerrado",
        _ => "cc-badge-abierto",
    };
}

<div class="cc-wrap">
    <div class="cc-card">
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:6px;">
            <a asp-controller="Request" asp-action="Start" class="cc-btn cc-btn-outline" style="padding:10px 16px;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="cc-page-title" style="text-align:left; margin-bottom:2px;">Mis solicitudes</h1>
                <p class="cc-page-subtitle" style="text-align:left; margin-bottom:0;">Estatus de los tickets asociados a tu cédula @ViewBag.CurrentEmployee.EmployeeIdNumber</p>
            </div>
        </div>

        <div style="margin-top:26px;">
            @if (!Model.Any())
            {
                <div class="cc-empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>Aún no tienes solicitudes registradas.</p>
                    <a class="cc-btn cc-btn-primary" style="margin:14px auto 0;" asp-controller="Request" asp-action="NewRequest">
                        Generar solicitud <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            }
            else
            {
                foreach (var ticket in Model)
                {
                    <a class="cc-ticket-card" asp-controller="Request" asp-action="TicketDetail" asp-route-number="@ticket.Number">
                        <div class="cc-ticket-top">
                            <div>
                                <div class="cc-ticket-number">@ticket.Number</div>
                                <div class="cc-ticket-type"><i class="bi @ticket.RequestTypeIcon" style="color:var(--cc-primary); margin-right:6px;"></i>@ticket.RequestTypeName</div>
                            </div>
                            <span class="cc-badge @BadgeClass(ticket.Status)"><span class="cc-badge-dot"></span>@ticket.Status</span>
                        </div>
                        <p class="cc-ticket-desc">@ticket.Description</p>
                        <div class="cc-ticket-meta">
                            <span><i class="bi bi-calendar3"></i> @ticket.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</span>
                            @if (!string.IsNullOrEmpty(ticket.AssignedTechnician))
                            {
                                <span><i class="bi bi-person-badge"></i> @ticket.AssignedTechnician</span>
                            }
                            @if (ticket.MinutesSpent.HasValue)
                            {
                                <span><i class="bi bi-stopwatch"></i> @ticket.MinutesSpent min. invertidos</span>
                            }
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</div>

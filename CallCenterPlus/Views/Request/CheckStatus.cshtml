@model List<CallCenterPlus.Models.MyRequestRow>
@{
    ViewData["Title"] = "Consultar estatus";

    string BadgeClass(int statusId) => statusId switch
    {
        1 => "cc-badge-abierto",
        2 => "cc-badge-abierto",
        3 => "cc-badge-enproceso",
        4 => "cc-badge-resuelto",
        5 => "cc-badge-cerrado",
        _ => "cc-badge-abierto",
    };
}

<div class="cc-wrap cc-wrap-wide">
    <div class="cc-card">
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:6px;">
            <a asp-controller="Request" asp-action="Start" class="cc-btn cc-btn-outline" style="padding:10px 16px;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="cc-page-title" style="text-align:left; margin-bottom:2px;">Mis solicitudes</h1>
                <p class="cc-page-subtitle" style="text-align:left; margin-bottom:0;">Estatus de los tickets asociados a tu cédula @ViewBag.CurrentEmployee.EmployeeIdNumber</p>
            </div>
        </div>

        @if (ViewBag.LoadFailed == true)
        {
            <div class="cc-alert-note" style="background:var(--cc-warning-light); color:#a5680a; margin-top:18px;">
                <i class="bi bi-exclamation-triangle"></i>
                <span>No pudimos cargar algunos datos. Es posible que la información mostrada esté incompleta.</span>
            </div>
        }

        <div style="margin-top:26px;">
            @if (!Model.Any())
            {
                <div class="cc-empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>Aún no tienes solicitudes registradas.</p>
                    <a class="cc-btn cc-btn-primary" style="margin:14px auto 0;" asp-controller="Request" asp-action="NewRequest">
                        Generar solicitud <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            }
            else
            {
                <div class="cc-table-wrap">
                    <table class="cc-table">
                        <thead>
                            <tr>
                                <th>Tipo de solicitud</th>
                                <th>Comentarios</th>
                                <th>Fecha</th>
                                <th>Estatus</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="cc-table-type">
                                            <i class="bi @request.RequestTypeIcon"></i>
                                            <span>@request.RequestTypeName</span>
                                        </div>
                                    </td>
                                    <td class="cc-table-remarks" title="@request.TicketRemarks">@request.TicketRemarks</td>
                                    <td>@request.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</td>
                                    <td><span class="cc-badge @BadgeClass(request.TicketStatusId)"><span class="cc-badge-dot"></span>@request.StatusName</span></td>
                                    <td style="text-align:right;">
                                        <a class="cc-btn cc-btn-outline cc-btn-sm" asp-controller="Request" asp-action="TicketDetail" asp-route-id="@request.TicketId">
                                            <i class="bi bi-eye"></i> Ver movimientos
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@model CallCenterPlus.Models.MyRequestDetailViewModel
@{
    ViewData["Title"] = "Detalle de solicitud #" + Model.TicketId;
    var ticketNumber = $"TCK-{Model.CreatedAt:yyyy}-{Model.TicketId:000000}";

    string BadgeClass(int statusId) => statusId switch
    {
        1 => "cc-badge-abierto",
        2 => "cc-badge-abierto",
        3 => "cc-badge-enproceso",
        4 => "cc-badge-resuelto",
        5 => "cc-badge-cerrado",
        _ => "cc-badge-abierto",
    };
}

<div class="cc-wrap">
    <div class="cc-card">
        <a asp-controller="Request" asp-action="CheckStatus" class="cc-btn cc-btn-outline" style="padding:10px 16px; margin-bottom:22px;">
            <i class="bi bi-arrow-left"></i> Mis solicitudes
        </a>

        @if (ViewBag.SuccessMessage is not null)
        {
            <div class="cc-alert-note" style="background:var(--cc-success-light); color:var(--cc-success); margin-bottom:18px;">
                <i class="bi bi-check-circle"></i>
                <span>@ViewBag.SuccessMessage</span>
            </div>
        }

        <div class="cc-detail-header">
            <div>
                <div class="cc-ticket-number">@ticketNumber</div>
                <h1 class="cc-page-title" style="text-align:left; margin-bottom:0;">
                    <i class="bi @Model.RequestTypeIcon" style="color:var(--cc-primary); margin-right:8px;"></i>@Model.RequestTypeName
                </h1>
            </div>
            <span class="cc-badge @BadgeClass(Model.TicketStatusId)" style="font-size:.8rem; padding:8px 16px;">
                <span class="cc-badge-dot"></span>@Model.StatusName
            </span>
        </div>

        <p style="color:var(--cc-text-muted); font-size:.92rem; line-height:1.6;">@(string.IsNullOrWhiteSpace(Model.Description) ? "Sin detalles adicionales." : Model.Description)</p>

        @if (Model.TicketStatusId == 4 || Model.TicketStatusId == 5)
        {
            <a class="cc-btn cc-btn-outline" asp-controller="Request" asp-action="ReopenTicket" asp-route-id="@Model.TicketId">
                <i class="bi bi-arrow-counterclockwise"></i> Reabrir solicitud
            </a>
        }

        <div class="cc-detail-grid">
            <div class="cc-detail-stat">
                <div class="cc-summary-label">Técnico asignado</div>
                <div class="cc-summary-value">@(Model.AssignedTechnician ?? "Por asignar")</div>
            </div>
            <div class="cc-detail-stat">
                <div class="cc-summary-label">Minutos invertidos</div>
                <div class="cc-summary-value">@(Model.MinutesSpent.HasValue ? $"{Model.MinutesSpent} min" : "—")</div>
            </div>
            <div class="cc-detail-stat">
                <div class="cc-summary-label">Última actualización</div>
                <div class="cc-summary-value" style="font-size:.85rem;">@Model.UpdatedAt.ToString("dd/MM/yyyy hh:mm tt")</div>
            </div>
        </div>

        <h6 style="font-weight:700; margin:28px 0 16px; font-size:.9rem;">
            <i class="bi bi-clock-history"></i> Seguimiento
        </h6>

        <div class="cc-timeline">
            <div class="cc-timeline-item is-user">
                <div class="cc-timeline-dot"><i class="bi bi-flag"></i></div>
                <div class="cc-timeline-content">
                    <span class="cc-timeline-author">Solicitud creada</span>
                    <span class="cc-timeline-date">@Model.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</span>
                    <p class="cc-timeline-text">@(string.IsNullOrWhiteSpace(Model.Description) ? "Sin detalles adicionales." : Model.Description)</p>
                </div>
            </div>

            @if (!Model.Movements.Any())
            {
                <div class="cc-timeline-item">
                    <div class="cc-timeline-dot"><i class="bi bi-hourglass-split"></i></div>
                    <div class="cc-timeline-content">
                        <span class="cc-timeline-author">En espera de asignación</span>
                        <p class="cc-timeline-text" style="color:var(--cc-text-muted);">Un técnico tomará tu caso pronto.</p>
                    </div>
                </div>
            }
            else
            {
                foreach (var movement in Model.Movements)
                {
                    <div class="cc-timeline-item">
                        <div class="cc-timeline-dot"><i class="bi bi-person-workspace"></i></div>
                        <div class="cc-timeline-content">
                            <span class="cc-timeline-author">@(movement.FullName ?? "Técnico")</span>
                            <span class="cc-timeline-date">@movement.TicketMovementDate.ToString("dd/MM/yyyy hh:mm tt")</span>
                            <p class="cc-timeline-text">@(!string.IsNullOrWhiteSpace(movement.TicketDetailProcessDescrption) ? movement.TicketDetailProcessDescrption : movement.TicketDetailRemarksByTechnician)</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

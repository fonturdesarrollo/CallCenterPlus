@model CallCenterPlus.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="ag-card ag-card-narrow">
    <div class="ag-card-header">
        <div>
            <h2>Cambiar contraseña</h2>
            <p>Actualiza la contraseña de tu cuenta</p>
        </div>
    </div>

    @if (ViewBag.SuccessMessage is not null)
    {
        <div class="ag-alert-success">
            <i class="bi bi-check-circle"></i>
            <span>@ViewBag.SuccessMessage</span>
        </div>
    }

    <form asp-controller="AgentAccount" asp-action="ChangePassword" method="post" id="changePasswordForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="ag-error" style="margin-bottom:14px;"></div>

        <div class="ag-field">
            <label asp-for="CurrentPassword">Contraseña actual</label>
            <div class="ag-password-field">
                <input asp-for="CurrentPassword" type="password" class="ag-input" autocomplete="current-password" placeholder="Tu contraseña actual" required />
                <button type="button" class="ag-password-toggle" aria-label="Mostrar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="CurrentPassword" class="ag-error"></span>
        </div>

        <div class="ag-field">
            <label asp-for="NewPassword">Nueva contraseña</label>
            <div class="ag-password-field">
                <input asp-for="NewPassword" type="password" class="ag-input" autocomplete="new-password" placeholder="Al menos 6 caracteres" required minlength="6" />
                <button type="button" class="ag-password-toggle" aria-label="Mostrar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="ag-error"></span>
        </div>

        <div class="ag-field">
            <label asp-for="ConfirmPassword">Confirmar nueva contraseña</label>
            <div class="ag-password-field">
                <input asp-for="ConfirmPassword" type="password" class="ag-input" autocomplete="new-password" placeholder="Repite la nueva contraseña" required />
                <button type="button" class="ag-password-toggle" aria-label="Mostrar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="ag-error"></span>
        </div>

        <div class="ag-form-actions">
            <a class="ag-btn ag-btn-outline" asp-controller="Agent" asp-action="Requests">Cancelar</a>
            <button type="submit" class="ag-btn ag-btn-primary">
                <i class="bi bi-shield-check"></i> Actualizar contraseña
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('changePasswordForm');
            if (form && window.agLocalizeValidation) {
                agLocalizeValidation(form);
            }
            if (form && window.agConfirm) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    if (!form.checkValidity()) {
                        form.reportValidity();
                        return;
                    }

                    agConfirm('¿Deseas actualizar tu contraseña?', function () {
                        form.submit();
                    }, { title: 'Cambiar contraseña', acceptText: 'Actualizar', cancelText: 'Cancelar' });
                });
            }
        })();
    </script>
}

@model CallCenterPlus.Models.AgentDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    string BadgeClass(string status) => status switch
    {
        "En cola" => "ag-badge-info",
        "Asignado" => "ag-badge-primary",
        "En proceso" => "ag-badge-warning",
        "Resuelto" => "ag-badge-success",
        _ => "ag-badge-info",
    };
}
@functions {
    string BuildSparklinePoints(List<int> values, int width = 100, int height = 30)
    {
        if (values is null || values.Count == 0) return "";
        var min = values.Min();
        var max = values.Max();
        var range = max - min;
        if (range == 0) range = 1;
        var step = values.Count == 1 ? 0 : (double)width / (values.Count - 1);
        var points = new List<string>();
        for (int i = 0; i < values.Count; i++)
        {
            var x = i * step;
            var y = height - ((values[i] - min) / (double)range * height);
            points.Add(x.ToString(System.Globalization.CultureInfo.InvariantCulture) + "," + y.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }
        return string.Join(" ", points);
    }
}

@* KPI cards *@
<div class="ag-kpi-row">
    @foreach (var kpi in Model.Kpis)
    {
        <div class="ag-kpi-card @kpi.ColorClass">
            <div class="ag-kpi-top">
                <div>
                    <div class="ag-kpi-value">@kpi.Value <span class="ag-kpi-trend"><i class="bi bi-arrow-@(kpi.TrendUp ? "up" : "down")"></i>@kpi.TrendLabel</span></div>
                    <div class="ag-kpi-label">@kpi.Label</div>
                </div>
                <button type="button" class="ag-kpi-menu" title="Más opciones"><i class="bi bi-three-dots-vertical"></i></button>
            </div>
            <svg class="ag-kpi-spark" viewBox="0 0 100 30" preserveAspectRatio="none">
                <polyline points="@BuildSparklinePoints(kpi.Sparkline)" fill="none" stroke="rgba(255,255,255,.85)" stroke-width="2" />
            </svg>
        </div>
    }
</div>

@* Main trend chart *@
<div class="ag-card">
    <div class="ag-card-header">
        <div>
            <h2>Solicitudes</h2>
            <p>Últimos 12 meses</p>
        </div>
        <div class="ag-chart-controls">
            <div class="ag-segmented" id="rangeSegmented">
                <button type="button" data-range="day">Día</button>
                <button type="button" data-range="week">Semana</button>
                <button type="button" class="is-active" data-range="month">Mes</button>
            </div>
            <button type="button" class="ag-icon-btn ag-icon-btn-primary" title="Exportar"><i class="bi bi-download"></i></button>
        </div>
    </div>
    <div class="ag-chart-wrap">
        <canvas id="requestsChart" height="90"></canvas>
    </div>
    <div class="ag-metrics-row">
        <div class="ag-metric ag-metric-primary">
            <div class="ag-metric-label">Total solicitudes</div>
            <div class="ag-metric-value">30</div>
        </div>
        <div class="ag-metric ag-metric-info">
            <div class="ag-metric-label">Pendientes</div>
            <div class="ag-metric-value">18</div>
        </div>
        <div class="ag-metric ag-metric-warning">
            <div class="ag-metric-label">En proceso</div>
            <div class="ag-metric-value">7</div>
        </div>
        <div class="ag-metric ag-metric-success">
            <div class="ag-metric-label">Resueltas</div>
            <div class="ag-metric-value">5</div>
        </div>
        <div class="ag-metric ag-metric-danger">
            <div class="ag-metric-label">Cumplimiento</div>
            <div class="ag-metric-value">83%</div>
        </div>
    </div>
</div>

@* Category cards *@
<div class="ag-category-row">
    @{
        var categoryColors = new[] { "ag-cat-primary", "ag-cat-danger", "ag-cat-info" };
    }
    @for (int i = 0; i < Model.TopCategories.Count; i++)
    {
        var category = Model.TopCategories[i];
        <div class="ag-category-card @categoryColors[i % categoryColors.Length]">
            <div class="ag-category-icon"><i class="bi @category.Icon"></i></div>
            <div class="ag-category-stats">
                <div>
                    <div class="ag-category-value">@category.Count</div>
                    <div class="ag-category-label">Solicitudes</div>
                </div>
                <div>
                    <div class="ag-category-value">@(category.Percentage)%</div>
                    <div class="ag-category-label">del total</div>
                </div>
            </div>
            <div class="ag-category-name">@category.Name</div>
        </div>
    }
</div>

@* Weekly summary *@
<div class="ag-card">
    <div class="ag-card-header">
        <div>
            <h2>Resumen semanal</h2>
            <p>Solicitudes nuevas vs. resueltas</p>
        </div>
    </div>

    <div class="ag-weekly-grid">
        <div class="ag-weekly-left">
            <div class="ag-stat-blocks">
                <div class="ag-stat-block ag-stat-info">
                    <div class="ag-stat-label">Nuevas hoy</div>
                    <div class="ag-stat-value">12</div>
                </div>
                <div class="ag-stat-block ag-stat-danger">
                    <div class="ag-stat-label">Reabiertas</div>
                    <div class="ag-stat-value">2</div>
                </div>
                <div class="ag-stat-block ag-stat-warning">
                    <div class="ag-stat-label">Asignadas</div>
                    <div class="ag-stat-value">9</div>
                </div>
                <div class="ag-stat-block ag-stat-success">
                    <div class="ag-stat-label">Cerradas</div>
                    <div class="ag-stat-value">5</div>
                </div>
            </div>

            @{
                var weekdays = new (string Day, int New, int Resolved)[]
                {
                    ("Lunes", 8, 5), ("Martes", 6, 7), ("Miércoles", 9, 4),
                    ("Jueves", 5, 6), ("Viernes", 10, 8), ("Sábado", 3, 2), ("Domingo", 1, 1),
                };
                var maxVal = weekdays.Max(w => Math.Max(w.New, w.Resolved));
            }
            <div class="ag-weekday-list">
                @foreach (var day in weekdays)
                {
                    <div class="ag-weekday-row">
                        <span class="ag-weekday-name">@day.Day</span>
                        <div class="ag-weekday-bars">
                            <div class="ag-weekday-bar ag-weekday-bar-new" style="width:@((day.New * 100 / maxVal))%"></div>
                            <div class="ag-weekday-bar ag-weekday-bar-resolved" style="width:@((day.Resolved * 100 / maxVal))%"></div>
                        </div>
                    </div>
                }
            </div>
            <div class="ag-weekday-legend">
                <span><i class="ag-legend-dot ag-legend-dot-new"></i> Nuevas</span>
                <span><i class="ag-legend-dot ag-legend-dot-resolved"></i> Resueltas</span>
            </div>
        </div>

        <div class="ag-weekly-right">
            <div class="ag-status-label">Estatus de las solicitudes</div>
            <div class="ag-status-list">
                <div class="ag-status-row">
                    <i class="bi bi-hourglass-split ag-status-icon"></i>
                    <span class="ag-status-name">En cola</span>
                    <span class="ag-status-count">18 (52%)</span>
                </div>
                <div class="ag-status-progress"><div class="ag-status-progress-fill ag-status-fill-info" style="width:52%"></div></div>

                <div class="ag-status-row">
                    <i class="bi bi-person-check ag-status-icon"></i>
                    <span class="ag-status-name">Asignado</span>
                    <span class="ag-status-count">9 (26%)</span>
                </div>
                <div class="ag-status-progress"><div class="ag-status-progress-fill ag-status-fill-primary" style="width:26%"></div></div>

                <div class="ag-status-row">
                    <i class="bi bi-gear ag-status-icon"></i>
                    <span class="ag-status-name">En proceso</span>
                    <span class="ag-status-count">7 (17%)</span>
                </div>
                <div class="ag-status-progress"><div class="ag-status-progress-fill ag-status-fill-warning" style="width:17%"></div></div>

                <div class="ag-status-row">
                    <i class="bi bi-check-circle ag-status-icon"></i>
                    <span class="ag-status-name">Resuelto</span>
                    <span class="ag-status-count">5 (14%)</span>
                </div>
                <div class="ag-status-progress"><div class="ag-status-progress-fill ag-status-fill-success" style="width:14%"></div></div>
            </div>
        </div>
    </div>
</div>

@* Pending requests table *@
<div class="ag-card">
    <div class="ag-card-header">
        <div>
            <h2>Solicitudes pendientes</h2>
            <p>Tickets a la espera de ser tomados por un agente</p>
        </div>
        <a class="ag-btn ag-btn-outline ag-btn-sm" asp-controller="Agent" asp-action="Requests">Ver todas</a>
    </div>

    @if (ViewBag.LoadFailed == true)
    {
        <div class="ag-alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <span>No pudimos cargar algunos datos (tickets o catálogo de categorías). Intenta de nuevo en unos minutos.</span>
        </div>
    }

    @if (!Model.PendingRequests.Any())
    {
        <div class="ag-empty-state">
            <i class="bi bi-inbox"></i>
            <p>No hay solicitudes en cola por el momento.</p>
        </div>
    }
    else
    {
        <div class="ag-table-wrap">
            <table class="ag-table">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th>Tipo de solicitud</th>
                        <th>Categoría</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.PendingRequests)
                    {
                        <tr>
                            <td>
                                <div class="ag-table-user">
                                    <div class="ag-table-avatar">@request.Initials</div>
                                    <div>
                                        <div class="ag-table-user-name">@request.EmployeeName</div>
                                        <div class="ag-table-user-dept">@request.Department</div>
                                    </div>
                                </div>
                            </td>
                            <td>@request.RequestTypeName</td>
                            <td>@request.CategoryName</td>
                            <td>@request.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td><span class="ag-badge @BadgeClass(request.Status)">@request.Status</span></td>
                            <td class="text-end">
                                <button type="button" class="ag-btn ag-btn-outline ag-btn-sm" disabled title="Disponible próximamente">
                                    Tomar ticket
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var ctx = document.getElementById('requestsChart').getContext('2d');
            var labels = {
                day: ['08:00', '10:00', '12:00', '14:00', '16:00', '18:00'],
                week: ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'],
                month: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'],
            };
            var datasets = {
                day: { received: [2, 4, 6, 5, 7, 4], resolved: [1, 2, 3, 4, 4, 3] },
                week: { received: [8, 6, 9, 5, 10, 3, 1], resolved: [5, 7, 4, 6, 8, 2, 1] },
                month: { received: [20, 24, 18, 26, 22, 30, 28, 25, 27, 24, 26, 22], resolved: [15, 18, 16, 20, 19, 24, 22, 21, 22, 20, 21, 19] },
            };

            var chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels.month,
                    datasets: [
                        {
                            label: 'Recibidas',
                            data: datasets.month.received,
                            borderColor: '#4b3fd6',
                            backgroundColor: 'rgba(75,63,214,0.12)',
                            fill: true,
                            tension: 0.4,
                            pointRadius: 0,
                            borderWidth: 2,
                        },
                        {
                            label: 'Resueltas',
                            data: datasets.month.resolved,
                            borderColor: '#2eb85c',
                            backgroundColor: 'transparent',
                            fill: false,
                            tension: 0.4,
                            pointRadius: 0,
                            borderWidth: 2,
                        },
                    ],
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#eceff2' } },
                        x: { grid: { display: false } },
                    },
                },
            });

            var buttons = document.querySelectorAll('#rangeSegmented button');
            buttons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    buttons.forEach(function (b) { b.classList.remove('is-active'); });
                    btn.classList.add('is-active');
                    var range = btn.dataset.range;
                    chart.data.labels = labels[range];
                    chart.data.datasets[0].data = datasets[range].received;
                    chart.data.datasets[1].data = datasets[range].resolved;
                    chart.update();
                });
            });
        })();
    </script>
}

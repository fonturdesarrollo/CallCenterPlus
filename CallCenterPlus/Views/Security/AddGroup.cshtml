@model CallCenterPlus.Models.SecurityGroupModel
@{
    ViewData["Title"] = "Agregar grupo";
}

<div class="ag-card ag-card-narrow">
    <div class="ag-card-header">
        <div>
            <h2>Agregar grupo</h2>
            <p>Crea un nuevo grupo de seguridad</p>
        </div>
    </div>

    @if (ViewBag.SuccessMessage is not null)
    {
        <div class="ag-alert-success">
            <i class="bi bi-check-circle"></i>
            <span>@ViewBag.SuccessMessage</span>
        </div>
    }

    @if (ViewBag.SubmitError is not null)
    {
        <div class="ag-alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <span>@ViewBag.SubmitError</span>
        </div>
    }

    <form asp-controller="Security" asp-action="AddGroup" method="post" id="addGroupForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="ag-error" style="margin-bottom:14px;"></div>

        <div class="ag-form-grid">
            <div class="ag-field ag-form-grid-full">
                <label asp-for="SecurityGroupName">Nombre del grupo</label>
                <input asp-for="SecurityGroupName" class="ag-input" placeholder="Ej: Agentes" autocomplete="off" required />
                <span asp-validation-for="SecurityGroupName" class="ag-error"></span>
            </div>

            <div class="ag-field ag-form-grid-full">
                <label asp-for="SecurityGroupDescription">Descripción</label>
                <textarea asp-for="SecurityGroupDescription" class="ag-input" placeholder="Describe el propósito de este grupo" required></textarea>
                <span asp-validation-for="SecurityGroupDescription" class="ag-error"></span>
            </div>
        </div>

        <div class="ag-form-actions">
            <a class="ag-btn ag-btn-outline" asp-controller="Agent" asp-action="Dashboard">Cancelar</a>
            <button type="submit" class="ag-btn ag-btn-primary">
                <i class="bi bi-people"></i> Crear grupo
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('addGroupForm');
            if (form && window.agLocalizeValidation) {
                agLocalizeValidation(form);
            }
            if (form && window.agConfirm) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    if (!form.checkValidity()) {
                        form.reportValidity();
                        return;
                    }

                    agConfirm('¿Deseas guardar este nuevo grupo?', function () {
                        form.submit();
                    }, { title: 'Guardar grupo', acceptText: 'Guardar', cancelText: 'Cancelar' });
                });
            }
        })();
    </script>
}

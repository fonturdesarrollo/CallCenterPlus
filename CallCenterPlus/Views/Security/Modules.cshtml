@model List<CallCenterPlus.Models.SecurityModuleModel>
@{
    ViewData["Title"] = "Modificar módulo";
}

<div class="ag-card">
    <div class="ag-card-header">
        <div>
            <h2>Módulos del sistema</h2>
            <p>Selecciona un módulo para modificar sus datos</p>
        </div>
        <a class="ag-btn ag-btn-primary ag-btn-sm" asp-controller="Security" asp-action="AddModule">
            <i class="bi bi-puzzle"></i> Agregar módulo
        </a>
    </div>

    @if (ViewBag.SuccessMessage is not null)
    {
        <div class="ag-alert-success">
            <i class="bi bi-check-circle"></i>
            <span>@ViewBag.SuccessMessage</span>
        </div>
    }

    @if (ViewBag.LoadFailed == true)
    {
        <div class="ag-alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <span>No pudimos cargar la lista de módulos. Intenta de nuevo en unos minutos.</span>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="ag-empty-state">
            <i class="bi bi-puzzle"></i>
            <p>Todavía no hay módulos registrados.</p>
        </div>
    }
    else
    {
        <div class="ag-search-field">
            <i class="bi bi-search"></i>
            <input type="text" id="modulesSearchInput" class="ag-input" placeholder="Buscar por nombre o descripción..." />
        </div>

        <div class="ag-table-wrap">
            <table class="ag-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="modulesTableBody">
                    @foreach (var module in Model)
                    {
                        <tr>
                            <td class="ag-table-user-name">@module.SecurityModuleName</td>
                            <td>@module.SecurityModuleDescription</td>
                            <td class="text-end">
                                <a class="ag-btn ag-btn-outline ag-btn-sm" asp-controller="Security" asp-action="EditModule" asp-route-id="@module.SecurityModuleId">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                            </td>
                        </tr>
                    }
                    <tr id="modulesNoMatchRow" style="display:none;">
                        <td colspan="3" class="ag-empty-state" style="padding:24px;">
                            <i class="bi bi-search"></i>
                            <p>No se encontraron módulos que coincidan con tu búsqueda.</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="ag-pagination" id="modulesPagination" style="display:none;">
            <button type="button" class="ag-btn ag-btn-outline ag-btn-sm" id="modulesPrevPage">
                <i class="bi bi-chevron-left"></i> Anterior
            </button>
            <span class="ag-pagination-info" id="modulesPageInfo">Página 1 de 1</span>
            <button type="button" class="ag-btn ag-btn-outline ag-btn-sm" id="modulesNextPage">
                Siguiente <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var tableBody = document.getElementById('modulesTableBody');
            if (!tableBody) return;

            var searchInput = document.getElementById('modulesSearchInput');
            var noMatchRow = document.getElementById('modulesNoMatchRow');
            var pagination = document.getElementById('modulesPagination');
            var pageInfo = document.getElementById('modulesPageInfo');
            var prevButton = document.getElementById('modulesPrevPage');
            var nextButton = document.getElementById('modulesNextPage');

            var pageSize = 10;
            var currentPage = 1;

            var allRows = Array.prototype.slice.call(tableBody.querySelectorAll('tr'))
                .filter(function (row) { return row !== noMatchRow; });

            function getMatchingRows() {
                var term = searchInput ? searchInput.value.trim().toLowerCase() : '';
                if (!term) return allRows;

                return allRows.filter(function (row) {
                    return row.textContent.toLowerCase().indexOf(term) !== -1;
                });
            }

            function render() {
                var matching = getMatchingRows();
                var totalPages = Math.max(1, Math.ceil(matching.length / pageSize));
                currentPage = Math.min(Math.max(currentPage, 1), totalPages);

                var start = (currentPage - 1) * pageSize;
                var pageRows = matching.slice(start, start + pageSize);

                allRows.forEach(function (row) { row.style.display = 'none'; });
                pageRows.forEach(function (row) { row.style.display = ''; });

                if (noMatchRow) {
                    noMatchRow.style.display = matching.length === 0 ? '' : 'none';
                }

                if (pagination) {
                    pagination.style.display = matching.length > pageSize ? '' : 'none';
                }
                if (pageInfo) {
                    pageInfo.textContent = 'Página ' + currentPage + ' de ' + totalPages;
                }
                if (prevButton) {
                    prevButton.disabled = currentPage <= 1;
                }
                if (nextButton) {
                    nextButton.disabled = currentPage >= totalPages;
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    currentPage = 1;
                    render();
                });
            }
            if (prevButton) {
                prevButton.addEventListener('click', function () {
                    currentPage--;
                    render();
                });
            }
            if (nextButton) {
                nextButton.addEventListener('click', function () {
                    currentPage++;
                    render();
                });
            }

            render();
        })();
    </script>
}

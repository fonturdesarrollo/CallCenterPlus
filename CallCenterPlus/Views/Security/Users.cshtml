@model List<CallCenterPlus.Models.SecurityUserViewModel>
@{
    ViewData["Title"] = "Modificar usuario";

    string BadgeClass(string? status) => status switch
    {
        "Activo" => "ag-badge-success",
        "Inactivo" => "ag-badge-warning",
        "Bloqueado" => "ag-badge-danger",
        _ => "ag-badge-info",
    };
}

<div class="ag-card">
    <div class="ag-card-header">
        <div>
            <h2>Usuarios del sistema</h2>
            <p>Selecciona un usuario para modificar sus datos</p>
        </div>
        <a class="ag-btn ag-btn-primary ag-btn-sm" asp-controller="Security" asp-action="AddUser">
            <i class="bi bi-person-plus"></i> Agregar usuario
        </a>
    </div>

    @if (ViewBag.SuccessMessage is not null)
    {
        <div class="ag-alert-success">
            <i class="bi bi-check-circle"></i>
            <span>@ViewBag.SuccessMessage</span>
        </div>
    }

    @if (ViewBag.LoadFailed == true)
    {
        <div class="ag-alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <span>No pudimos cargar la lista de usuarios. Intenta de nuevo en unos minutos.</span>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="ag-empty-state">
            <i class="bi bi-people"></i>
            <p>Todavía no hay usuarios registrados.</p>
        </div>
    }
    else
    {
        <div class="ag-search-field">
            <i class="bi bi-search"></i>
            <input type="text" id="usersSearchInput" class="ag-input" placeholder="Buscar por usuario, cédula, grupo, provincia o estatus..." />
        </div>

        <div class="ag-table-wrap">
            <table class="ag-table">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Cédula</th>
                        <th>Grupo</th>
                        <th>Provincia</th>
                        <th>Estatus</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="ag-table-user-name">@user.FullName</div>
                                <div class="ag-table-user-dept">@user.UserName</div>
                            </td>
                            <td>@user.SecurityUserDocumentIdNumber</td>
                            <td>@user.SecurityGroupName</td>
                            <td>@user.StateName</td>
                            <td><span class="ag-badge @BadgeClass(user.SecurityStatusName)">@user.SecurityStatusName</span></td>
                            <td class="text-end">
                                <a class="ag-btn ag-btn-outline ag-btn-sm" asp-controller="Security" asp-action="EditUser" asp-route-id="@user.SecurityUserId">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                            </td>
                        </tr>
                    }
                    <tr id="usersNoMatchRow" style="display:none;">
                        <td colspan="6" class="ag-empty-state" style="padding:24px;">
                            <i class="bi bi-search"></i>
                            <p>No se encontraron usuarios que coincidan con tu búsqueda.</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="ag-pagination" id="usersPagination" style="display:none;">
            <button type="button" class="ag-btn ag-btn-outline ag-btn-sm" id="usersPrevPage">
                <i class="bi bi-chevron-left"></i> Anterior
            </button>
            <span class="ag-pagination-info" id="usersPageInfo">Página 1 de 1</span>
            <button type="button" class="ag-btn ag-btn-outline ag-btn-sm" id="usersNextPage">
                Siguiente <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var tableBody = document.getElementById('usersTableBody');
            if (!tableBody) return;

            var searchInput = document.getElementById('usersSearchInput');
            var noMatchRow = document.getElementById('usersNoMatchRow');
            var pagination = document.getElementById('usersPagination');
            var pageInfo = document.getElementById('usersPageInfo');
            var prevButton = document.getElementById('usersPrevPage');
            var nextButton = document.getElementById('usersNextPage');

            var pageSize = 10;
            var currentPage = 1;

            var allRows = Array.prototype.slice.call(tableBody.querySelectorAll('tr'))
                .filter(function (row) { return row !== noMatchRow; });

            function getMatchingRows() {
                var term = searchInput ? searchInput.value.trim().toLowerCase() : '';
                if (!term) return allRows;

                return allRows.filter(function (row) {
                    return row.textContent.toLowerCase().indexOf(term) !== -1;
                });
            }

            function render() {
                var matching = getMatchingRows();
                var totalPages = Math.max(1, Math.ceil(matching.length / pageSize));
                currentPage = Math.min(Math.max(currentPage, 1), totalPages);

                var start = (currentPage - 1) * pageSize;
                var pageRows = matching.slice(start, start + pageSize);

                allRows.forEach(function (row) { row.style.display = 'none'; });
                pageRows.forEach(function (row) { row.style.display = ''; });

                if (noMatchRow) {
                    noMatchRow.style.display = matching.length === 0 ? '' : 'none';
                }

                if (pagination) {
                    pagination.style.display = matching.length > pageSize ? '' : 'none';
                }
                if (pageInfo) {
                    pageInfo.textContent = 'Página ' + currentPage + ' de ' + totalPages;
                }
                if (prevButton) {
                    prevButton.disabled = currentPage <= 1;
                }
                if (nextButton) {
                    nextButton.disabled = currentPage >= totalPages;
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    currentPage = 1;
                    render();
                });
            }
            if (prevButton) {
                prevButton.addEventListener('click', function () {
                    currentPage--;
                    render();
                });
            }
            if (nextButton) {
                nextButton.addEventListener('click', function () {
                    currentPage++;
                    render();
                });
            }

            render();
        })();
    </script>
}

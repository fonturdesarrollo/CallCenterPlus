@model CallCenterPlus.Models.LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
}

<div class="cc-login-page">
    <div class="cc-wrap cc-wrap-narrow" style="padding-top:0;padding-bottom:0;">
        <div class="cc-card">
            <div class="cc-login-logo">
                <i class="bi bi-headset"></i>
            </div>
            <h1 class="cc-page-title">Portal de Soporte Técnico</h1>
            <p class="cc-page-subtitle">Ingresa tu número de cédula para generar una solicitud o consultar el estatus de un ticket.</p>

            <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="cc-error" style="margin-bottom:14px;"></div>
                <div class="cc-field">
                    <label class="cc-label" asp-for="NationalId">Número de cédula</label>
                    <input asp-for="NationalId" class="cc-input" placeholder="Ej: 12345678" autocomplete="off" autofocus />
                    <span asp-validation-for="NationalId" class="cc-error"></span>
                </div>

                <button type="submit" class="cc-btn cc-btn-primary cc-btn-full">
                    Ingresar <i class="bi bi-arrow-right"></i>
                </button>
            </form>
        </div>
    </div>
</div>
